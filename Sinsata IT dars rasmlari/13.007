<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="1200" height="675">
  <defs>
    <marker id="arrow-down" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
      <path d="M1,1 L4,7 L7,1" fill="none" stroke="#d4580a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
    <marker id="arrow-right" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
      <path d="M1,1 L7,4 L1,7" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <!-- Background -->
  <rect width="1200" height="675" fill="#f8f7fc" rx="0"/>

  <!-- Title question -->
  <text x="600" y="46" font-family="Segoe UI, system-ui, sans-serif" font-size="28" font-weight="800" fill="#1e1b4b" text-anchor="middle">
    <tspan fill="#1e1b4b">«</tspan><tspan fill="#c2410c">Сидоров</tspan><tspan fill="#1e1b4b">» ning </tspan><tspan fill="#6d28d9">балл</tspan><tspan fill="#1e1b4b">и нечта?</tspan>
  </text>
  <text x="600" y="72" font-family="Segoe UI, system-ui, sans-serif" font-size="15" fill="#6b7280" text-anchor="middle">ВПР aynan shu savolga javob beradi. Mantiq juda oddiy:</text>

  <!-- ===== TABLE ===== -->
  <!-- Table outline -->
  <rect x="80" y="108" width="580" height="370" fill="white" stroke="#d1d5db" stroke-width="1.5" rx="4"/>

  <!-- Header row -->
  <rect x="80" y="108" width="580" height="44" fill="#f0fdf4" rx="4"/>
  <rect x="80" y="108" width="580" height="44" fill="none" stroke="#d1d5db" stroke-width="1.5" rx="4"/>
  <line x1="80" y1="152" x2="660" y2="152" stroke="#d1d5db" stroke-width="1.5"/>

  <!-- Column dividers -->
  <line x1="280" y1="108" x2="280" y2="478" stroke="#d1d5db" stroke-width="1"/>
  <line x1="460" y1="108" x2="460" y2="478" stroke="#d1d5db" stroke-width="1"/>

  <!-- Row dividers -->
  <line x1="80" y1="198" x2="660" y2="198" stroke="#e5e7eb" stroke-width="1"/>
  <line x1="80" y1="244" x2="660" y2="244" stroke="#e5e7eb" stroke-width="1"/>
  <line x1="80" y1="290" x2="660" y2="290" stroke="#e5e7eb" stroke-width="1"/>
  <line x1="80" y1="336" x2="660" y2="336" stroke="#e5e7eb" stroke-width="1"/>
  <line x1="80" y1="382" x2="660" y2="382" stroke="#e5e7eb" stroke-width="1"/>
  <line x1="80" y1="428" x2="660" y2="428" stroke="#e5e7eb" stroke-width="1"/>

  <!-- Search column background -->
  <rect x="81" y="153" width="198" height="324" fill="#fff7ed" opacity="0.6"/>

  <!-- Header text -->
  <text x="180" y="136" font-family="Segoe UI, sans-serif" font-size="15" font-weight="700" fill="#166534" text-anchor="middle">Имя (1-ustun)</text>
  <text x="370" y="136" font-family="Segoe UI, sans-serif" font-size="15" font-weight="700" fill="#166534" text-anchor="middle">Предмет (2-ustun)</text>
  <text x="560" y="136" font-family="Segoe UI, sans-serif" font-size="15" font-weight="700" fill="#166534" text-anchor="middle">Балл (3-ustun)</text>

  <!-- Row 1: Иванов -->
  <text x="110" y="181" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Иванов</text>
  <text x="310" y="181" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Математика</text>
  <text x="590" y="181" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151" text-anchor="end">85</text>

  <!-- Row 2: Петров -->
  <text x="110" y="227" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Петров</text>
  <text x="310" y="227" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Физика</text>
  <text x="590" y="227" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151" text-anchor="end">92</text>

  <!-- Row 3: СИДОРОВ (found!) -->
  <rect x="81" y="245" width="578" height="45" fill="#fef3c7" opacity="0.7"/>
  <rect x="81" y="245" width="198" height="45" fill="#fed7aa"/>
  <rect x="461" y="245" width="198" height="45" fill="#ede9fe"/>
  <text x="110" y="274" font-family="Segoe UI, sans-serif" font-size="19" font-weight="900" fill="#c2410c">Сидоров</text>
  <text x="310" y="274" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">История</text>
  <text x="560" y="276" font-family="Segoe UI, sans-serif" font-size="26" font-weight="900" fill="#6d28d9" text-anchor="middle">78</text>

  <!-- Row 4: Кузнецов -->
  <text x="110" y="319" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Кузнецов</text>
  <text x="310" y="319" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Химия</text>
  <text x="590" y="319" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151" text-anchor="end">64</text>

  <!-- Row 5: Смирнов -->
  <text x="110" y="365" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Смирнов</text>
  <text x="310" y="365" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Литература</text>
  <text x="590" y="365" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151" text-anchor="end">88</text>

  <!-- Row 6: Попов -->
  <text x="110" y="411" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Попов</text>
  <text x="310" y="411" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Биология</text>
  <text x="590" y="411" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151" text-anchor="end">72</text>

  <!-- Row 7: Соколов -->
  <text x="110" y="457" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">Соколов</text>
  <text x="310" y="457" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151">География</text>
  <text x="590" y="457" font-family="Segoe UI, sans-serif" font-size="17" fill="#374151" text-anchor="end">81</text>

  <!-- ===== THE L-SHAPED PATH ===== -->
  <!-- Vertical arrow: searching down column 1 -->
  <path d="M 160 155 L 160 244" stroke="#d4580a" stroke-width="4" fill="none" stroke-linecap="round" marker-end="url(#arrow-down)" stroke-dasharray="8,4"/>

  <!-- Horizontal arrow: moving right to column 3 -->
  <path d="M 280 267 L 460 267" stroke="#7c3aed" stroke-width="4" fill="none" stroke-linecap="round" marker-end="url(#arrow-right)"/>

  <!-- Search label -->
  <rect x="168" y="185" width="98" height="24" rx="12" fill="#fff7ed" stroke="#d4580a" stroke-width="1"/>
  <text x="217" y="202" font-family="Segoe UI, sans-serif" font-size="12" font-weight="700" fill="#c2410c" text-anchor="middle">↓ Qidirish</text>

  <!-- Right arrow label -->
  <rect x="330" y="278" width="96" height="24" rx="12" fill="#f5f3ff" stroke="#7c3aed" stroke-width="1"/>
  <text x="378" y="295" font-family="Segoe UI, sans-serif" font-size="12" font-weight="700" fill="#6d28d9" text-anchor="middle">→ Natija ol</text>

  <!-- Found badge -->
  <rect x="95" y="246" width="18" height="18" rx="9" fill="#c2410c"/>
  <text x="104" y="259" font-family="Segoe UI, sans-serif" font-size="11" font-weight="800" fill="white" text-anchor="middle">✓</text>

  <!-- Result callout -->
  <rect x="520" y="215" width="82" height="28" rx="14" fill="#6d28d9"/>
  <text x="561" y="234" font-family="Segoe UI, sans-serif" font-size="13" font-weight="800" fill="white" text-anchor="middle">Javob!</text>
  <path d="M 556 243 L 561 252 L 566 243" fill="#6d28d9"/>

  <!-- ===== RIGHT SIDE: 3 STEPS ===== -->

  <!-- Step 1 -->
  <circle cx="718" cy="130" r="20" fill="#ea580c"/>
  <text x="718" y="137" font-family="Segoe UI, sans-serif" font-size="17" font-weight="900" fill="white" text-anchor="middle">1</text>
  <text x="750" y="126" font-family="Segoe UI, sans-serif" font-size="17" font-weight="800" fill="#1f2937">Pastga qarab qidiring</text>
  <text x="750" y="148" font-family="Segoe UI, sans-serif" font-size="14" fill="#6b7280">Birinchi ustundan «Сидоров» ni</text>
  <text x="750" y="167" font-family="Segoe UI, sans-serif" font-size="14" fill="#6b7280">toping (telefon daftaridek).</text>

  <!-- Step 2 -->
  <circle cx="718" cy="220" r="20" fill="#7c3aed"/>
  <text x="718" y="227" font-family="Segoe UI, sans-serif" font-size="17" font-weight="900" fill="white" text-anchor="middle">2</text>
  <text x="750" y="216" font-family="Segoe UI, sans-serif" font-size="17" font-weight="800" fill="#1f2937">O'ngga yuring</text>
  <text x="750" y="238" font-family="Segoe UI, sans-serif" font-size="14" fill="#6b7280">Topilgan qatordan 3-ustun</text>
  <text x="750" y="257" font-family="Segoe UI, sans-serif" font-size="14" fill="#6b7280">(Балл) ga qarang.</text>

  <!-- Step 3 -->
  <circle cx="718" cy="308" r="20" fill="#059669"/>
  <text x="718" y="315" font-family="Segoe UI, sans-serif" font-size="17" font-weight="900" fill="white" text-anchor="middle">3</text>
  <text x="750" y="304" font-family="Segoe UI, sans-serif" font-size="17" font-weight="800" fill="#1f2937">Natijani oling</text>
  <text x="750" y="326" font-family="Segoe UI, sans-serif" font-size="14" fill="#6b7280">Javob: 78. ВПР aynan shu</text>
  <text x="750" y="345" font-family="Segoe UI, sans-serif" font-size="14" fill="#6b7280">qiymatni qaytaradi.</text>

  <!-- Connecting dots between steps -->
  <line x1="718" y1="152" x2="718" y2="198" stroke="#e5e7eb" stroke-width="2" stroke-dasharray="3,3"/>
  <line x1="718" y1="242" x2="718" y2="286" stroke="#e5e7eb" stroke-width="2" stroke-dasharray="3,3"/>

  <!-- ===== FORMULA BOX ===== -->
  <rect x="698" y="380" width="460" height="170" rx="12" fill="#faf5ff" stroke="#c4b5fd" stroke-width="1.5"/>
  <text x="720" y="406" font-family="Segoe UI, sans-serif" font-size="12" font-weight="700" fill="#7c3aed" letter-spacing="0.05em">FORMULA (RUS TILIDA)</text>

  <text x="720" y="436" font-family="Consolas, monospace" font-size="18" font-weight="700">
    <tspan fill="#374151">=ВПР(</tspan><tspan fill="#c2410c">A2</tspan><tspan fill="#374151">; </tspan><tspan fill="#0369a1">$D$2:$F$10</tspan><tspan fill="#374151">; </tspan><tspan fill="#7c3aed">3</tspan><tspan fill="#374151">; </tspan><tspan fill="#b91c1c">ЛОЖЬ</tspan><tspan fill="#374151">)</tspan>
  </text>

  <!-- Argument explanations -->
  <circle cx="730" y="468" r="6" fill="#c2410c"/>
  <text x="744" y="472" font-family="Segoe UI, sans-serif" font-size="14" fill="#374151"><tspan font-weight="700" fill="#c2410c">A2</tspan> — nimani qidirish (Сидоров)</text>

  <circle cx="730" y="496" r="6" fill="#0369a1"/>
  <text x="744" y="500" font-family="Segoe UI, sans-serif" font-size="14" fill="#374151"><tspan font-weight="700" fill="#0369a1">$D$2:$F$10</tspan> — jadval oralig'i</text>

  <circle cx="730" y="524" r="6" fill="#7c3aed"/>
  <text x="744" y="528" font-family="Segoe UI, sans-serif" font-size="14" fill="#374151"><tspan font-weight="700" fill="#7c3aed">3</tspan> — nechanchi ustundan natija olish</text>

  <circle cx="960" y="468" r="6" fill="#b91c1c"/>
  <text x="974" y="472" font-family="Segoe UI, sans-serif" font-size="14" fill="#374151"><tspan font-weight="700" fill="#b91c1c">ЛОЖЬ</tspan> — aniq moslik (doim shuni yozing)</text>

  <!-- Bottom note -->
  <text x="600" y="658" font-family="Segoe UI, sans-serif" font-size="13" fill="#9ca3af" text-anchor="middle">ВПР = Вертикальный Просмотр (Vertical Lookup). Birinchi ustundan pastga qidiradi, kerakli ustundan natija oladi.</text>
</svg>